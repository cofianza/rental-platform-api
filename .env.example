# ============================================================
# Cofianza 2.0 - Backend API
# Variables de entorno requeridas
# Copiar a .env.local y completar con valores reales
# ============================================================

# --- Aplicacion ---
NODE_ENV=development
PORT=4000

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Logging ---
# Valores: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Proveedores de riesgo crediticio ---
# Usar mock provider para desarrollo (true/false)
CREDIT_PROVIDER_USE_MOCK=true
# Timeout por llamada a un buro, en ms. Politica de Evaluacion y Score V4.1
# seccion 14: 8 s. Es el valor de la politica y el default de ambos buros.
BURO_REQUEST_TIMEOUT_MS=8000
# Presupuesto total de la consulta (timeout + reintentos), en ms. SLA de
# decision automatica: 40 s.
BURO_SLA_TOTAL_MS=40000
# Override del timeout por proveedor (opcional). Sin valor, cada buro usa
# BURO_REQUEST_TIMEOUT_MS, SALVO TransUnion mientras TRANSUNION_API_URL siga
# apuntando a su host UAT: ahi el default sube a 45 s automaticamente, porque
# ese ambiente tarda 35-50 s sin estar caido y el corte de 8 s dejaria todos
# los estudios en 'fallido'. Al configurar el endpoint productivo de
# TransUnion, el default vuelve solo a los 8 s de la politica.
# TRANSUNION_REQUEST_TIMEOUT_MS=
# DATACREDITO_REQUEST_TIMEOUT_MS=
# TransUnion
TRANSUNION_API_URL=
TRANSUNION_API_KEY=
# SIFIN
SIFIN_API_URL=
SIFIN_API_KEY=
# DataCredito
DATACREDITO_API_URL=
DATACREDITO_API_KEY=

# --- Habeas data ---
# Vigencia de la autorizacion firmada, en meses. Se congela al firmar; cambiarla
# no reescribe las autorizaciones ya firmadas.
AUTORIZACION_VIGENCIA_MESES=12

# --- Tope de canon (flujo del modulo de estudios, seccion 4.4) ---
# Maximo canon en COP que Cofianza puede afianzar SIN acuerdo de coafianzamiento.
# Tope inclusivo: 3.000.000 exactos pasan; 3.000.001 se bloquea antes de cobrar.
# Regla TRANSITORIA: sube (o se retira) cuando exista el acuerdo. Definido por
# Gerencia el 2026-09-03. No confundir con la regla V3 del scorecard
# (canon/ingreso > 40%), que es una relacion, no un tope en pesos.
CANON_MAXIMO_SIN_COAFIANZAMIENTO_COP=3000000

# --- Gerencia General (Adenda 1 del módulo de contratos, respuesta 17) ---
# Correos de la Gerencia General, separados por coma (sin distinguir
# mayúsculas); cada uno debe ser de un administrador. Solo ellos cambian los
# parámetros de RIESGO de /admin/calibracion (topes de canon, umbrales de score,
# vigencia del CRC...); los OPERATIVOS (plazos en días), cualquier administrador.
# Sus cuentas (crear, contraseña, rol, desactivar, borrar) solo las gestiona la
# Gerencia General. Una entrada que no parece correo deja advertencia al arrancar.
# Vacía = cualquier administrador cambia todo (queda una advertencia al arrancar).
GERENCIA_GENERAL_EMAILS=

# --- Pasarela de pagos ---
# Proveedor activo: stripe | mercadopago (Colombia usa mercadopago)
PAYMENT_GATEWAY_PROVIDER=mercadopago
# URL publica de esta API (para el notification_url del webhook de MP)
API_PUBLIC_URL=https://tu-api.ejemplo.com
# Mercado Pago (Checkout Pro) — credenciales del panel de developers de MP
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Stripe (opcional — no opera en Colombia; solo para pruebas)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Auco background check (listas restrictivas + antecedentes + FOSYGA). OFF por
# defecto. Confirmar con scripts/test-auco-background.ts antes de encender.
AUCO_BACKGROUND_CHECK_ENABLED=false
AUCO_BACKGROUND_TIMEOUT_MS=90000

# Cotejo biometrico AucoFace en la autorizacion del prospecto. OFF por defecto:
# encenderlo cambia el texto legal que firma (declara el dato sensible).
AUCO_BIOMETRIA_ENABLED=false
AUCO_BIOMETRIA_UMBRAL_SIMILITUD=70
AUCO_BIOMETRIA_TIMEOUT_MS=20000

# Adenda 1 §2/§3: el scorecard DECIDE y la consulta va en cascada (Datacredito
# primaria; TransUnion solo en 40-89). OFF = el buro decide, motor en sombra.
# Antes de encender: npx ts-node -r tsconfig-paths/register scripts/check-decision-adenda.ts
MOTOR_DECIDE_ENABLED=false

# Contratos V3 · Entrega 4: clasificador IA de cláusulas adicionales. Sin
# efecto: la Adenda 1 del módulo de contratos (respuesta 13 bis) no la habilita
# y la inmobiliaria nunca pasa por la IA (en true, advertencia al arrancar).
CLAUSULAS_IA_ENABLED=false
# ANTHROPIC_API_KEY=

# Contratos V3 · Entrega 5: barrido de respaldo de la firma cada 15 min. En una
# API LOCAL (que apunta a la base de producción) ponerlo en false: si no, esa API
# también entrega avisos y correos de la firma, con enlaces a localhost.
FIRMA_V3_BARRIDO_ENABLED=true

# Adenda 1 contratos: cada hora cancela los borradores V3 con la reserva del
# inmueble vencida (DIAS_RESERVA_INMUEBLE hábiles sin enviar a firma) y avisa.
# En una API LOCAL (apunta a la base de producción) ponerlo en false.
RESERVA_V3_BARRIDO_ENABLED=true

# Ley 2300: cada 15 min manda los WhatsApp de cobro que quedaron para el horario
# permitido. Aparte del autoescalado de moras. En una API LOCAL (apunta a la
# base de producción) ponerlo en false.
MORAS_COBROS_PROGRAMADOS_ENABLED=true

# P28: plantillas v2 de mora (el comprobante va al arrendador por su WhatsApp de
# recaudo; en Fase 3, al correo de soporte). Encender cuando Meta las apruebe.
WHATSAPP_MORA_PLANTILLAS_V2=false
